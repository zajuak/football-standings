{
  "name": "football-standings-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://zajuak.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "football-standings",
      "database_id": "773b463c-1eee-468d-8445-8f0a3bc3aeca",
      "migrations_dir": "migrations"
    }
  ],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
