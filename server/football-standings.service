[Unit]
Description=Football standings website and API (independent campus database)
After=network.target

[Service]
Type=simple
User=football-standings
Group=football-standings
WorkingDirectory=/opt/football-standings/current
EnvironmentFile=/etc/football-standings.env
ExecStart=/opt/football-standings/runtime/bin/node /opt/football-standings/current/server/main.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/football-standings
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
